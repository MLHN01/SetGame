    sse_srv -->|"JDBC<br/>Replay verpasster Events"| sse_db
    jobqueue -->|"RabbitMqEventListener<br/>Queue app.rabbitmq.queue<br/>manuelles ACK, Fehler → DLQ"| sse_srv

%% GMN Adapter
    builder_srv -->|"Callback HTTP PUT<br/>MUSYS_BASE_URL Host:9090/api/v1"| traefik
